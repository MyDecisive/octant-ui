{
  "name": "octant-ui",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "tsc -b && eslint .",
    "preview": "vite preview",
    "docker-build": "docker build -t ghcr.io/mydecisive/octant-ui:$npm_package_version .",
    "build-to-kind": "npm run docker-build && kind load docker-image ghcr.io/mydecisive/octant-ui:$npm_package_version -n mdai",
    "local-deploy": "helm template octant-ui ./deployment -f ./deployment/values.yaml --set image.repository=ghcr.io/mydecisive/octant-ui --set image.tag=$npm_package_version --set image.pullPolicy=Always -n mdai | kubectl apply -n mdai -f -",
    "local-pod-restart": "kubectl rollout restart deployment/octant-ui -n mdai",
    "local-all": "npm run build-to-kind && npm run local-deploy && npm run local-pod-restart",
    "predeploy": "tsc -b && vite build --mode ghpages && ts-node scripts/postbuild.ts",
    "deploy": "gh-pages -d dist",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "predeploy:storybook": "npm run build-storybook",
    "deploy:storybook": "gh-pages -d storybook-static --dest storybook"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.8",
    "@mui/x-data-grid": "^8.27.5",
    "@mydecisiveai/octant-client": "^0.8.3-alpha",
    "classnames": "^2.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wouter": "^3.9.0",
    "yaml": "^2.8.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.39.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.3.5",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "playwright": "^1.59.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "storybook": "^10.3.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.4"
  }
}
