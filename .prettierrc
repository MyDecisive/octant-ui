{
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"importOrder": [
		"^react",
		"^(?!@components|@constants|@copy|@fieldValidation|@services|@store|@app-types|@utils)[a-zA-Z]",
		"^@(components|constants|copy|fieldValidation|services|store|app-types|utils)/(.*)$",
		"^\\.\\.\\/",
		"^\\.\\/"
	],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true
}